{
  "lang": "en",
  "autoThreshold": 0.78,
  "installedAutoThreshold": 0.84,
  "recommendThreshold": 0.62,
  "installedRecommendThreshold": 0.72,
  "minDirectTermsForAuto": 2,
  "autoMax": 2,
  "recommendMax": 2,
  "adoptionTracking": false,
  "indexTtlSeconds": 300,
  "staleDays": 180,
  "lowAdoptionMinExposures": 6,
  "lowAdoptionMaxRate": 0.15,
  "includeInstalledSkills": true,
  "includePrinciples": false,
  "sources": [
    { "path": "~/.gemini/skill-vault", "kind": "vault" },
    { "path": "~/.gemini/config/skills", "kind": "installed" },
    { "skillsJson": "~/.gemini/config/skills.json", "kind": "installed" },
    { "globPlugins": "~/.gemini/config/plugins", "subpath": "skills", "kind": "installed" },
    { "globPlugins": "~/.gemini/config/plugins", "subpath": "references/extra-skills", "kind": "folded" }
  ],
  "workspaceSignals": {
    "project.config.json": ["wechatide", "wechat", "miniprogram"],
    "tsconfig.json": ["typescript", "ts"],
    "package.json": ["frontend", "node", "ui"],
    "Cargo.toml": ["rust"],
    "pyproject.toml": ["python"]
  },
  "excludeSkills": [
    "agy-skill-router",
    "skill-router"
  ]
}
